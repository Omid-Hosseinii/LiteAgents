    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO employee_timeseries (\n    employee_id,\n    date,\n    total_tasks,\n    completed_tasks,\n    overdue_tasks,\n    estimated_hours,\n    actual_hours,\n    email_count\n)\nSELECT\n    employee_id,\n    DATE(timestamp) AS date,\n\n    COUNT(*) FILTER (\n        WHERE source = 'jira'\n    ) AS total_tasks,\n\n    COUNT(*) FILTER (\n        WHERE source = 'jira'\n        AND data->>'status' = 'done'\n    ) AS completed_tasks,\n\n    COUNT(*) FILTER (\n        WHERE source = 'jira'\n        AND data->>'status' = 'overdue'\n    ) AS overdue_tasks,\n\n    COALESCE(SUM(\n        CASE\n            WHEN source = 'jira'\n            THEN (data->>'estimated_hours')::NUMERIC\n            ELSE 0\n        END\n    ), 0) AS estimated_hours,\n\n    COALESCE(SUM(\n        CASE\n            WHEN source = 'jira'\n            THEN COALESCE((data->>'actual_hours')::NUMERIC, 0)\n            ELSE 0\n        END\n    ), 0) AS actual_hours,\n\n    COUNT(*) FILTER (\n        WHERE source = 'outlook'\n    ) AS email_count\n\nFROM employee_activity\nGROUP BY employee_id, DATE(timestamp);",
        "options": {}
      },
